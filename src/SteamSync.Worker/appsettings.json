{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "SteamApi": {
    "ApiKey": ""
  },
  "SyncWorker": {
    "Concurrency": 3,
    "BatchSize": 25,
    "SchemaTtlDays": 14,
    "GlobalPercentTtlHours": 24,
    "NightlyCron": "0 0 * * *",
    "MaxAttempts": 3,
    "MaxStoreEnrichPerLibrarySync": 5,
    "EnqueueGlobalPercentBackfillOnStartup": false
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "",
    "Password": "",
    "VirtualHost": "/"
  },
  "RateLimiter": {
    "MaxConcurrent": 3
  },
  "StartupHealthChecks": {
    "MaxAttempts": 5,
    "DelaySeconds": 5,
    "TimeoutSeconds": 10
  }
}
